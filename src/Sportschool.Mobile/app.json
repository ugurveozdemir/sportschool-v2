{
  "expo": {
    "name": "Sportschool",
    "slug": "sportschool-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sportschool",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031632"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
